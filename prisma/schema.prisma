// Terjemahan tabel di brainstorming.md bagian 1. Nama tabel dan kolom di DB snake_case (@@map / @map),
// field di kode camelCase. Aturan yang gak bisa diekspresiin di schema dijaga di service:
//   - Transisi status cuma maju, note wajib kalau status_after = rejected (TM-6)
//   - Hak akses per role (TM-3)

generator client {
  provider = "prisma-client"
  output   = "../src/lib/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskType {
  bug
  feature
  /// TM-19: kerjaan operasional (bikinin akun dll), cuma Request → Done.
  support

  @@map("task_type")
}

enum TaskStatus {
  request
  queue
  in_progress   @map("in-progress")
  ready_to_test @map("ready-to-test")
  done
  done_live     @map("done-live")
  rejected

  @@map("task_status")
}

enum UserRole {
  marketing
  developer
  qa
  admin

  @@map("user_role")
}

enum UserStatus {
  active
  non_active @map("non-active")

  @@map("user_status")
}

enum TaskEditField {
  title
  description
  type
  platform
  /// TM-21: task ini hasil recreate. old_value = id task asal, new_value = judul task asal.
  recreate

  @@map("task_edit_field")
}

/// TM-12: platform yang kena task. Satu task = satu platform, wajib diisi. `other` dipakai
/// juga sebagai default buat task lama (migration) dan safety-net kolom.
enum TaskPlatform {
  api
  mobile
  ai_chat @map("ai-chat")
  web
  other

  @@map("task_platform")
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  email     String     @unique
  role      UserRole
  status    UserStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  tasks           Task[]
  taskHistory     TaskHistory[]
  taskAttachments TaskAttachment[]
  taskEdits       TaskEdit[]
  apiTokens       ApiToken[]

  @@map("users")
}

model Task {
  id              String       @id @default(uuid()) @db.Uuid
  title           String
  description     String
  type            TaskType
  platform        TaskPlatform @default(other)
  status          TaskStatus   @default(request)
  /// Urutan antrean, kecil = duluan. Dipakai di kolom request dan queue, diabaikan di status lain.
  ordering        Int          @default(0)
  createdById     String       @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  /// TM-21: task Rejected yang di-recreate jadi task ini. Unik = satu task cuma bisa di-recreate sekali.
  recreatedFromId String?      @unique @map("recreated_from") @db.Uuid

  createdBy     User             @relation(fields: [createdById], references: [id])
  recreatedFrom Task?            @relation("TaskRecreate", fields: [recreatedFromId], references: [id])
  recreatedAs   Task?            @relation("TaskRecreate")
  history       TaskHistory[]
  attachments   TaskAttachment[]
  edits         TaskEdit[]

  @@index([status, ordering])
  @@map("task")
}

model TaskHistory {
  id           String      @id @default(uuid()) @db.Uuid
  taskId       String      @map("task_id") @db.Uuid
  /// null = event pertama (task lahir)
  statusBefore TaskStatus? @map("status_before")
  statusAfter  TaskStatus  @map("status_after")
  /// Wajib kalau statusAfter = rejected (dicek di service). Link hasil pas done ditaro di sini juga.
  note         String?
  createdById  String      @map("created_by") @db.Uuid
  /// TM-17: nama API token yang dipakai ("Iyan via Kuli Coding"). null = lewat UI.
  via          String?
  createdAt    DateTime    @default(now()) @map("created_at")

  task      Task @relation(fields: [taskId], references: [id])
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([taskId])
  @@map("task_history")
}

/// TM-11: 1 baris per edit title/description yang sukses (status Request/Queue saja). Nilai lama disimpan
/// biar audit-nya beneran bisa jawab "sebelumnya apa", bukan cuma "berubah".
model TaskEdit {
  id         String        @id @default(uuid()) @db.Uuid
  taskId     String        @map("task_id") @db.Uuid
  field      TaskEditField
  oldValue   String        @map("old_value")
  newValue   String        @map("new_value")
  editedById String        @map("edited_by") @db.Uuid
  /// TM-17: nama API token yang dipakai. null = lewat UI.
  via        String?
  createdAt  DateTime      @default(now()) @map("created_at")

  task     Task @relation(fields: [taskId], references: [id])
  editedBy User @relation(fields: [editedById], references: [id])

  @@index([taskId])
  @@map("task_edit")
}

model TaskAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  /// Nama asli dari pengunggah
  fileName    String   @map("file_name")
  /// Path relatif di storage/attachment/<task_id>/<uuid>.<ext>
  filePath    String   @map("file_path")
  /// Label jenis file dari browser, mis. image/png. Dipakai nyaring upload dan nampilin
  mimeType    String   @map("mime_type")
  /// Byte
  size        Int
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  task      Task @relation(fields: [taskId], references: [id])
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([taskId])
  @@map("task_attachment")
}

/// TM-17: token API per user (maks 5). Token = user pemiliknya, hak sama persis kayak di UI. Yang disimpan
/// cuma SHA-256 dari token; token aslinya cuma ditampilin sekali pas dibikin. Revoke = baris dihapus.
model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Nama bebas dari user (mis. "Kuli Coding"), ikut kecatet di history sebagai `via`.
  name       String
  tokenHash  String    @unique @map("token_hash")
  /// Awalan token (mis. "tm_Jx8kQ2") buat dikenalin di daftar, bukan rahasia.
  prefix     String
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_token")
}
