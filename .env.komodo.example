# Contoh isi buat kolom Environment stack `komodo.stack.yml` di Komodo.
#
# Salin isi file ini, ganti nilainya, tempel ke kolom Environment stack-nya
# di UI Komodo. Ini bukan `.env` yang dibaca otomatis dari disk — cuma
# referensi/contekan, biar gak ada var yang kelupaan.

# ── WAJIB ──────────────────────────────────────────────────────────────────

# Versi image yang udah di-build DI MESIN TUJUAN (pull_policy: never).
# Samain sama "version" di package.json / tag terakhir yang di-build.
APP_VERSION=

# Postgres EKSISTING (bukan container di stack ini). Kalau Postgres-nya di
# jaringan docker yang sama, pakai hostname container-nya; kalau di host yang
# sama tapi luar docker, bisa host.docker.internal (sudah di-extra_hosts di
# compose-nya).
DATABASE_URL=

# Minimal 32 karakter, random. Contoh generate: openssl rand -hex 32
COOKIE_SIGN_SECRET=

# Password login satu-satunya (lihat src/lib/server/secret.ts — kosong =
# server nolak nyala di production).
AUTH_ADMIN=

SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=

# Alamat publik situs, persis: skema + domain, tanpa garis miring di belakang.
# Tanpa ini, semua POST (task baru, transisi status, upload) ditolak 403
# diam-diam — halaman tetap kebuka normal.
ORIGIN=

# ── OPSIONAL ───────────────────────────────────────────────────────────────

# Kosong = 5M.
UPLOAD_SIZE_LIMIT=

# local (default, volume di stack ini) atau s3. Isi S3_* di bawah kalau s3.
STORAGE_DRIVER=

S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Default: https://s3.<S3_REGION>.wasabisys.com
S3_ENDPOINT=
# true cuma buat MinIO
S3_FORCE_PATH_STYLE=
# default atau when_required (pakai when_required kalau provider nolak checksum bawaan SDK)
S3_CHECKSUM=

# ── PENYESUAIAN MESIN ──────────────────────────────────────────────────────

# Jaringan docker tempat Cloudflare Tunnel nongkrong di maal-app-s01. Kosong =
# cf-tunnel_cf-tunnel (dari stack lain yang udah jalan di situ) — cek ulang
# sebelum deploy pertama, isi kalau ternyata beda.
# TM_PROXY_NETWORK=

# Tempat lampiran. Kosong = volume bernama `task-monitor-storage`. Isi path
# host kalau mau bind mount, mis.:
# TM_STORAGE_DIR=/mnt/data/task-monitor/storage
