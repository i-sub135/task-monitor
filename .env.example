DATABASE_URL=
COOKIE_SIGN_SECRET=
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
ORIGIN=
APP_VERSION=
AUTH_ADMIN=
UPLOAD_SIZE_LIMIT=5M
# Tempat lampiran: local (folder storage/attachment) atau s3 (Wasabi / bucket S3-compatible)
STORAGE_DRIVER=local
# Cuma dipakai kalau STORAGE_DRIVER=s3. Region + bucket + key wajib; sisanya opsional.
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Default: https://s3.<S3_REGION>.wasabisys.com
S3_ENDPOINT=
# true cuma buat MinIO
S3_FORCE_PATH_STYLE=
# default atau when_required. Pakai when_required kalau provider nolak checksum bawaan SDK
S3_CHECKSUM=
